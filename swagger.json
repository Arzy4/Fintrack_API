  "info": {
    "title": "Fintrack API",
    "description": "The Fintrack API description",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Full name of the user"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com",
            "description": "Unique email address of the user"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "description": "Password for the user account (minimum 8 characters)",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "BCA Savings",
            "description": "Name of the financial account"
          },
          "type": {
            "type": "string",
            "example": "bank",
            "enum": [
              "bank",
              "e-wallet",
              "cash"
            ],
            "description": "Type of financial account"
          },
          "balance": {
            "type": "number",
            "example": 5000000,
            "description": "Current account balance",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "type",
          "balance"
        ]
      },
      "UpdateAccountDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Food",
            "description": "Name of the transaction category"
          },
          "type": {
            "type": "string",
            "example": "expense",
            "enum": [
              "income",
              "expense"
            ],
            "description": "Type of category (income or expense)"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {}
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "number",
            "example": 1,
            "description": "ID of the account where the transaction is recorded"
          },
          "category_id": {
            "type": "number",
            "example": 2,
            "description": "ID of the category assigned to this transaction"
          },
          "type": {
            "type": "string",
            "example": "expense",
            "enum": [
              "income",
              "expense"
            ],
            "description": "Type of transaction (income or expense)"
          },
          "amount": {
            "type": "number",
            "example": 50000,
            "description": "Transaction amount",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "example": "Lunch at a restaurant",
            "description": "Short description of the transaction"
          },
          "transaction_date": {
            "type": "string",
            "example": "2026-08-04",
            "description": "Transaction date in YYYY-MM-DD format",
            "format": "date"
          }
        },
        "required": [
          "account_id",
          "category_id",
          "type",
          "amount",
          "description",
          "transaction_date"
        ]
      },
      "UpdateTransactionDto": {
        "type": "object",
        "properties": {}
      },
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
